{
  "name": "living-repository",
  "productName": "Living Repository",
  "version": "0.1.0",
  "description": "A writing environment for writers and scholars that links people, places, topics and scripture as you write.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "tsx src/server/devServer.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win",
    "build:web": "vite build -c vite.web.config.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "chokidar": "^5.0.0",
    "mammoth": "^1.13.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@types/node": "^26.6.3",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "path-browserify": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
